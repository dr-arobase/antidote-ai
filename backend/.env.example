# Variables d'environnement — copier ce fichier en .env et remplir les valeurs

NODE_ENV=development
PORT=5000

# MongoDB — URI de connexion (locale ou Atlas)
MONGODB_URI=mongodb://localhost:27017/antidote

# JWT — clé secrète et durée d'expiration
JWT_SECRET=changez_cette_cle_secrete_en_production_minimum_32_caracteres
JWT_EXPIRE=7d

# URL du frontend (CORS)
CLIENT_URL=http://localhost:5173

# LanguageTool API (laisser la valeur par défaut pour l'API publique gratuite)
LANGUAGE_TOOL_URL=https://api.languagetool.org/v2/check
